{
  "name": "azure-sre-poc",
  "image": "mcr.microsoft.com/devcontainers/dotnet:1-10.0",
  "features": {
    "ghcr.io/devcontainers/features/azure-cli:1": { "installBicep": true },
    "ghcr.io/azure/azure-dev/azd:0": {},
    "ghcr.io/devcontainers/features/python:1": { "version": "3.12" },
    "ghcr.io/devcontainers/features/github-cli:1": {}
  },
  "postCreateCommand": "pip install --user -r data/requirements.txt && dotnet restore src/Coaching.slnx",
  "customizations": {
    "vscode": {
      "extensions": [
        "ms-azuretools.vscode-bicep",
        "ms-azuretools.azure-dev",
        "ms-dotnettools.csdevkit",
        "ms-python.python",
        "ms-azuretools.vscode-cosmosdb"
      ]
    }
  }
}
